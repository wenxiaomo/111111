class IntuitionisticTripletEvidence(nn.Module):
    def __init__(self, n_balls, n_clusters):
        super().__init__()
        self.n_balls = n_balls
        self.n_clusters = n_clusters

        self.register_buffer(
            "triplet_logits", torch.zeros(n_balls, n_clusters, 3)
        )

    def get_triplets(self):
        p = torch.softmax(self.triplet_logits, dim=-1)
        return p[..., 0], p[..., 1], p[..., 2]

    def signed_coefficient(self):
        mu, nu, _ = self.get_triplets()
        return mu - nu

    def residual(self, c_b, H):
        return c_b - self.signed_coefficient() @ H

    @staticmethod
    def negative_entropy(p):
        p = torch.clamp(p, min=1e-12)
        return (p * torch.log(p)).sum()

    def negative_entropy_loss(self):
        mu, nu, pi = self.get_triplets()
        return (
            self.negative_entropy(mu)
            + self.negative_entropy(nu)
            + self.negative_entropy(pi)
        )

    @torch.no_grad()
    def update_assignment(self, c_b, H, Sigma_inv, alpha, beta,
                          lambda_1, n_inner=1):
        mu, nu, pi = self.get_triplets()
        p = torch.stack([mu, nu, pi], dim=-1)

        for _ in range(n_inner):
            w = p[..., 0] - p[..., 1]
            v = c_b - w @ H

            Sinv_v = v @ Sigma_inv.T
            u = 2.0 * alpha[:, None] * (Sinv_v @ H.T)
            g = torch.stack(
                [-u, u, torch.zeros_like(u)], dim=-1
            )

            log_p = torch.log(torch.clamp(p, min=1e-12))
            z = (
                log_p - beta[:, None, None] * g
            ) / (
                1.0 + beta[:, None, None] * lambda_1
            )
            z = z - z.max(dim=-1, keepdim=True).values
            p = torch.softmax(z, dim=-1)

        p = torch.clamp(p, min=1e-8)
        p = p / p.sum(dim=-1, keepdim=True)
        self.triplet_logits.copy_(torch.log(p))
        return p

    @torch.no_grad()
    def inherit_by_overlap(self, new_index_sets, old_index_sets,
                           mu, nu, pi):
        N_G = len(new_index_sets)
        shape = (N_G, self.n_clusters)
        new_mu = mu.new_zeros(shape)
        new_nu = nu.new_zeros(shape)
        new_pi = pi.new_zeros(shape)

        for l in range(N_G):
            new_set = set(new_index_sets[l].tolist())
            if len(new_set) == 0:
                continue

            for i, old_set in enumerate(old_index_sets):
                old_set = set(old_set.tolist())
                inter = len(new_set & old_set)
                if inter == 0:
                    continue

                frac = inter / len(new_set)
                new_mu[l] += frac * mu[i]
                new_nu[l] += frac * nu[i]
                new_pi[l] += frac * pi[i]

        p = torch.stack([new_mu, new_nu, new_pi], dim=-1)
        p = p / (p.sum(dim=-1, keepdim=True) + 1e-12)
        p = torch.clamp(p, min=1e-8)
        p = p / p.sum(dim=-1, keepdim=True)

        self.triplet_logits = torch.log(p)
        self.n_balls = N_G
        return p[..., 0], p[..., 1], p[..., 2]
