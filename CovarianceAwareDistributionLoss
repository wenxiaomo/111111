class CovarianceAwareDistributionLoss(nn.Module):
    def __init__(self, latent_dim, delta=1e-3, eps=1.0,
                 tau_r=1.0, gamma_sigma=1.0):
        super().__init__()
        self.latent_dim = latent_dim
        self.delta = delta
        self.eps = eps
        self.tau_r = tau_r
        self.gamma_sigma = gamma_sigma

        self.register_buffer(
            "Sigma", torch.eye(latent_dim) * max(1.0, delta)
        )

    def get_sigma(self):
        return self.Sigma

    def mahalanobis(self, v):
        L = torch.linalg.cholesky(self.get_sigma())
        y = torch.linalg.solve_triangular(L, v.T, upper=False)
        return y.square().sum(dim=0)

    def robust_penalty(self, q):
        return (1.0 + self.eps) * q / torch.sqrt(q + self.eps ** 2)

    def scale_weight(self, r_b):
        return torch.exp(-r_b.square() / self.tau_r ** 2)

    def forward(self, v, r_b):
        q = self.mahalanobis(v)
        rho = self.robust_penalty(q)
        omega = self.scale_weight(r_b)
        log_det = torch.logdet(self.get_sigma())

        loss = (omega * rho).sum() + 0.5 * self.gamma_sigma * log_det
        return loss, {
            "q": q,
            "rho": rho,
            "omega": omega,
            "log_det": log_det,
        }

    @torch.no_grad()
    def update_sigma(self, alpha, v):
        # alpha_i = omega_i * d_i^(t)
        S = (v * alpha[:, None]).T @ v
        S = 0.5 * (S + S.T)

        eigvals, eigvecs = torch.linalg.eigh(S)
        eigvals = eigvals.clamp_min(0.0)
        new_eig = (2.0 * eigvals / self.gamma_sigma).clamp_min(self.delta)

        Sigma_new = (eigvecs * new_eig[None, :]) @ eigvecs.T
        Sigma_new = 0.5 * (Sigma_new + Sigma_new.T)

        self.Sigma.copy_(Sigma_new)
        return self.Sigma
