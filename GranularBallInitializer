import numpy as np
from sklearn.cluster import KMeans


class GranularBallInitializer:

        c_i     = mean(X[I_i])
        r_i     = max_{k in I_i} ||x_k - c_i||_2
        sigma_i = mean_{k in I_i} ||x_k - c_i||_2
        eta_i   = sigma_i / (sigma_i + tau)


    def __init__(self, n_balls, tau=1.0, radius_type='max', random_state=42):
        self.n_balls = n_balls
        self.tau = tau
        self.radius_type = radius_type
        self.random_state = random_state

    def ball_kmeans(self, X):

        km = KMeans(n_clusters=self.n_balls,
                    random_state=self.random_state, n_init=10)
        sample_ball_id = km.fit_predict(X)
        return sample_ball_id.astype(np.int64), km.cluster_centers_

    def compute_descriptor(self, X, sample_ball_id):
        X = np.asarray(X, dtype=np.float64)
        N_G = self.n_balls
        d0 = X.shape[1]
        centers = np.zeros((N_G, d0), dtype=np.float64)
        radii = np.zeros(N_G, dtype=np.float64)
        sigmas = np.zeros(N_G, dtype=np.float64)
        etas = np.zeros(N_G, dtype=np.float64)

        for i in range(N_G):
            members = X[sample_ball_id == i]
            if members.shape[0] == 0:
                centers[i] = np.zeros(d0)
                radii[i] = 1e-6
                sigmas[i] = 0.0
                etas[i] = 0.0
                continue
            c_i = members.mean(axis=0)
            dist = np.linalg.norm(members - c_i, axis=1)
            if self.radius_type == 'max':
                r_i = float(dist.max())
            else:
                r_i = float(np.percentile(dist, 90))
            sigma_i = float(dist.mean())
            eta_i = sigma_i / (sigma_i + self.tau + 1e-12)
            centers[i] = c_i
            radii[i] = r_i + 1e-6
            sigmas[i] = sigma_i
            etas[i] = eta_i
        return centers, radii, sigmas, etas

    def build_descriptors(self, centers, radii, etas):
        """s_i = [c_i, r_i, eta_i] in R^{d0+2}。"""
        return np.concatenate(
            [centers, radii[:, None], etas[:, None]], axis=1
        ).astype(np.float64)

    def init(self, X):
        sample_ball_id, _ = self.ball_kmeans(X)
        centers, radii, sigmas, etas = self.compute_descriptor(X, sample_ball_id)
        s = self.build_descriptors(centers, radii, etas)
        return {
            'sample_ball_id': sample_ball_id,
            'centers': centers,
            'radii': radii,
            'sigmas': sigmas,
            'etas': etas,
            's': s,
        }

    def recompute(self, X, sample_ball_id):
        centers, radii, sigmas, etas = self.compute_descriptor(X, sample_ball_id)
        s = self.build_descriptors(centers, radii, etas)
        return centers, radii, sigmas, etas, s
